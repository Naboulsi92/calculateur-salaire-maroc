// Déploiement Cloudflare Workers Builds (push master → `npx wrangler deploy`).
// Ce fichier rend le deploy non-interactif : sans lui, wrangler tente une
// auto-configuration « Vite » (installation @cloudflare/vite-plugin, patch du
// vite.config) qui échoue — notre build est un MPA statique (vite build → dist/
// 2 pages), servi tel quel via assets.directory. Ne pas ajouter le plugin Vite
// Cloudflare : il transformerait le build MPA en worker bundle.
// `not_found_handling: 404-page` = les chemins inconnus servent dist/404.html
// avec le statut 404 (plus propre pour le SEO que le fallback SPA par défaut,
// qui renvoyait index.html avec 200).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calculateur-salaire-maroc",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    // `html_handling: none` = `.html` servi tel quel (200), aucune normalisation
    // d'URL. Le défaut « auto-trailing-slash » renvoyait 307 de
    // /salaire-net-2027.html vers /salaire-net-2027, en contradiction avec le
    // canonical, le sitemap et le maillage interne (tous en .html) — audit
    // OpenSEO 27/10/2026. Avec « none », l'URL canonique est celle servie.
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
